Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 30
      Color: 110; 110; 115
      Alpha: 0.5
      Line Style:
        Line Width: 0.03
        Value: Lines
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.6
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 140; 0
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.2
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 230; 60; 60
        Alpha: 1
        Shaft Length: 0.4
        Shaft Radius: 0.03
        Head Length: 0.12
        Head Radius: 0.07
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Ground truth
      Enabled: true
      Topic:
        Value: /ground_truth/pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 60; 200; 90
      Alpha: 1
      Shaft Length: 0.6
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.09
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Goal
      Enabled: true
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.5
      Axes Radius: 0.05
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 70
      X: 4
      Y: 0
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Enable Stereo Rendering:
        Value: false
      Invert Z Axis: false
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 860
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
